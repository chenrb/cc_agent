# CC Agent 后端配置示例
# 复制为 .env 后按需修改；不创建 .env 则全部使用默认值

# ---- Redis 消息总线 ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
# REDIS_PASSWORD=

# ---- SQLite 持久化 ----
# 数据库文件名（相对 backend/ 目录）
AGENT_DB_NAME=cc_agent.db

# ---- 可选功能 ----
# AMAP_API_KEY=
# CLAWHUB_API_TOKEN=

# ---- JWT 鉴权 ----
# 生成: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7
CC_BOOTSTRAP_ADMIN_USERNAME=admin
CC_BOOTSTRAP_ADMIN_PASSWORD=
CORS_ALLOWED_ORIGINS=
# COOKIE_SECURE=     # 留空=自动(跟随 https)
